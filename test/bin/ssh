#!/usr/bin/env python3
"""Fake ssh for the migpath suite. Answers the read-only commands migpath sends to leaves and
edges from the world file (FP_TEST_WORLD) and from the mock Global Managers' state:
  vtysh ... show bgp ipv4 unicast <prefix> json   best path from which side's segment is ON and advertised
  bridge -j vlan show / ip -j addr show / cat /etc/network/interfaces   from world["leaves"][host]
  get bridge                                       from the bridge entries on the mock segments"""
import ipaddress
import json
import os
import re
import ssl
import sys
import urllib.request

CTX = ssl._create_unverified_context()
try:
    WORLD = json.load(open(os.environ.get("FP_TEST_WORLD", "")))
except Exception:
    WORLD = {}


def dest_cmd():
    a, i = sys.argv[1:], 0
    while i < len(a):
        if a[i] == "-o":
            i += 2
        elif a[i].startswith("-"):
            i += 1
        else:
            break
    return a[i].split("@")[-1], " ".join(a[i + 1:])


def gm_state(port):
    req = urllib.request.Request("https://127.0.0.1:%d/mock/state" % port, data=b"{}", method="POST",
                                 headers={"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, context=CTX))["S"]


def advertised(S, prefix, pl):
    on = False
    for k, o in S.items():
        if not k.startswith("/segments/") or not o.get("connectivity_path"):
            continue
        if str((o.get("advanced_config") or {}).get("connectivity") or "ON").upper() != "ON":
            continue
        for sub in o.get("subnets") or []:
            gw = sub.get("gateway_address")
            if gw and str(ipaddress.ip_interface(gw).network) == prefix:
                on = True
    if not on:
        return False
    if pl:                                  # Green: the stretched Tier-0's outbound filter must let it out
        return any(p.get("network") == prefix and p.get("action") == "PERMIT"
                   for k, o in S.items() if k.endswith("/prefix-lists/" + pl) for p in o.get("prefixes") or [])
    return True


def render(leaf):
    ports = leaf["ports"]
    L = ["# Auto-generated by NVUE!", "", "auto lo", "iface lo inet loopback", ""]
    for p, own in sorted(ports.items()):
        L += ["auto %s" % p, "iface %s" % p]
        if p == "peerlink":
            L.append("    bond-slaves swp49 swp50")
        if own is not None:
            L.append("    bridge-vids %s" % " ".join(str(v) for v in sorted(own)))
        L.append("")
    L += ["auto br_default", "iface br_default", "    bridge-ports %s" % " ".join(sorted(ports)),
          "    bridge-vlan-aware yes", "    bridge-vids %s" % " ".join(str(v) for v in sorted(leaf["bridge_vids"])),
          "    bridge-pvid 1", ""]
    return "\n".join(L)


def main():
    host, cmd = dest_cmd()
    if host.split(".")[0] in (WORLD.get("refuse") or []):         # test hook: this node refuses the password
        sys.stderr.write("%s: Permission denied (publickey,password).\n" % host)
        return 255
    m = re.search(r"show bgp ipv4 unicast (\S+) json", cmd)
    if m:
        prefix = m.group(1)
        side = (WORLD.get("route_stuck") or {}).get(prefix)
        if not side:
            g, b = advertised(gm_state(9443), prefix, "PL-STRETCHED-OUT"), advertised(gm_state(9444), prefix, None)
            side = "blue" if b else "green" if g else None
        if not side:
            print("{}")
            return 0
        print(json.dumps({"prefix": prefix, "paths": [{"aspath": {"string": "65001" if side == "green" else "65002",
                                                                  "length": 1},
                                                       "bestpath": {"overall": True}, "valid": True}]}))
        return 0
    leaf = (WORLD.get("leaves") or {}).get(host)
    if leaf is not None:
        if leaf.get("down"):
            sys.stderr.write("ssh: connect to host %s port 22: Connection refused\n" % host)
            return 255
        if cmd.endswith("bridge -j vlan show"):
            out = [{"ifname": "br_default", "vlans": [{"vlan": v} for v in sorted(leaf["bridge_vids"])]}]
            for p, own in sorted(leaf["ports"].items()):
                out.append({"ifname": p, "vlans": [{"vlan": v} for v in sorted(own if own is not None else leaf["bridge_vids"])]})
            print(json.dumps(out))
            return 0
        if cmd == "ip -j addr show":
            ad = leaf.get("svi_addrs") or {}
            print(json.dumps([{"ifname": n, "addr_info": [{"family": "inet", "local": x.split("/")[0], "prefixlen": int(x.split("/")[1])}
                                                           for x in ad.get(n) or []]
                               + [{"family": "inet6", "local": "fe80::1", "prefixlen": 64, "scope": "link"}]}
                              for n in ["lo", "eth0", "br_default"] + list(leaf.get("svis") or [])]))
            return 0
        if cmd == "cat /etc/network/interfaces":
            print(render(leaf))
            return 0
    if cmd == "get bridge":
        port = 9443 if host.startswith("green-a-bdg") else 9444 if host.startswith("blue-a-bdg") else None
        if port is None or host in (WORLD.get("edges_down") or []):
            sys.stderr.write("ssh: connect to host %s port 22: Connection timed out\n" % host)
            return 255
        primary = host.split(".")[0].endswith("01")
        blocks = []
        for k, o in sorted(gm_state(port).items()):
            if k.startswith("/segments/"):
                for e in o.get("bridge_profiles") or []:
                    blocks.append("Bridge Port UUID : %s-%s\nAttached Logical Switch Name: %s\nVLAN ID : %s\n"
                                  "State : %s\nDevice : fp-eth2\nDevice State : Up\nHA Failover Mode : Non-Preemptive\n"
                                  "State : %s\n" % (o["id"], e["vlan_ids"][0], o.get("display_name"), e["vlan_ids"][0],
                                                    "Forwarding" if primary else "Blocked",
                                                    "Active" if primary else "Standby"))
        print("\n".join(blocks))
        return 0
    sys.stderr.write("fake ssh: no answer for %s: %s\n" % (host, cmd))
    return 1


if __name__ == "__main__":
    sys.exit(main())
